pipeline {
    agent any
    
    environment {
        LABS = credentials('labcreds')
        JAVA_HOME = '/opt/bitnami/java'
        PATH = "${env.JAVA_HOME}/bin:${env.PATH}"
    }
    
    stages {
        stage('Build') {
            steps {
                    // Create a virtual environment with the project name (Retail pipeline)
                    sh 'python3 -m pip install --user --break-system-packages pipenv'
                    sh '/bitnami/jenkins/home/.local/bin/pipenv --rm || exit 0'
                    sh '/bitnami/jenkins/home/.local/bin/pipenv install'
            }
        }
        stage('Test') {
            steps {
                // Ensure JAVA_HOME is set for PySpark to work and Run tests (assuming you are using pytest for tests)
                sh '''
                export JAVA_HOME=/opt/bitnami/java
                export PATH=$JAVA_HOME/bin:$PATH
                echo $JAVA_HOME
                java -version
                ~/.local/bin/pipenv run pytest -v
                '''
            }
        }
        stage('Package') {
            steps {
                // Create the zip file but exclude the venv directory
                sh 'zip -r retailproject.zip .'
            }
        }
        stage('Deploy') {
            steps {
        sh '''
        sshpass -p $LABS_PSW scp \
        -o StrictHostKeyChecking=no \
        retailproject.zip \
        $LABS_USR@g01.itversity.com:/home/itv022777/
        '''
            }
        }
    }
}


